{
  "manifest_version": 3,
  "name": "Support Copilot – lokale KI für Jira",
  "version": "0.12.0",
  "description": "KI-gestützter Support-Assistent für klassische Jira-Vorgänge mit timio-Anruferkennung und Call-Cockpit (Anrufer, Gesprächsdauer, Wartefeld, Ticket-Abgleich) sowie Outbound-Modus (Gesprächsvorbereitung, Ergebnis-Erfassung, Rückrufliste). Zusammenfassung, Team-Doku, Einordnung, Antwort-Entwürfe und Qualitätscheck – automatisch, gecacht und vollständig lokal, ohne Cloud.",
  "permissions": ["storage", "clipboardWrite", "notifications", "alarms"],
  "host_permissions": ["https://ccc.my-phone.cloud/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Support Copilot – Wartefeld (klicken für timio)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://jira.ennit.de/*"],
      "js": [
        "src/config.js",
        "src/shared.js",
        "src/ai-cache.js",
        "src/jira-reader.js",
        "src/rules.js",
        "src/local-ai.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ccc.my-phone.cloud/*"],
      "js": [
        "src/config.js",
        "src/shared.js",
        "src/timio-content.js"
      ],
      "css": ["styles/timio.css"],
      "run_at": "document_idle"
    }
  ]
}
